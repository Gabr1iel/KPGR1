<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.panel.left.ColorsPanelController"
      styleClass="panel-block">

    <Label text="Aktivní barvy" styleClass="panel-section-title"/>
    <HBox styleClass="picker-row">
        <Button fx:id="mainColorPicker"
                onAction="#setActiveBtn"
                styleClass="color-btn, picker"
                style="-fx-background-color: #000000"
                userData="#000000"/>
        <Button fx:id="secondaryColorPicker"
                onAction="#setActiveBtn"
                styleClass="color-btn, picker"/>
        <Button text="Zrušit druhou"
                onAction="#clearSecondary"
                styleClass="link-btn"/>
    </HBox>

    <Region maxWidth="Infinity" styleClass="panel-separator"/>

    <Label text="Paleta" styleClass="panel-section-title"/>
    <FlowPane vgap="8" hgap="8" prefWrapLength="176" styleClass="palette">
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #FFFFFF" userData="#FFFFFF"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #E53935" userData="#E53935"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #FB8C00" userData="#FB8C00"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #FDD835" userData="#FDD835"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #C0CA33" userData="#C0CA33"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #43A047" userData="#43A047"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #00897B" userData="#00897B"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #00ACC1" userData="#00ACC1"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #29B6F6" userData="#29B6F6"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #1E88E5" userData="#1E88E5"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #3949AB" userData="#3949AB"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #8E24AA" userData="#8E24AA"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #D81B60" userData="#D81B60"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #EC407A" userData="#EC407A"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #F48FB1" userData="#F48FB1"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #FF7043" userData="#FF7043"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #FFCA28" userData="#FFCA28"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #8D6E63" userData="#8D6E63"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #9E9E9E" userData="#9E9E9E"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #546E7A" userData="#546E7A"/>
        <Button onAction="#changeColor" styleClass="color-btn" style="-fx-background-color: #212121" userData="#212121"/>
    </FlowPane>

    <Label text="Barvy platí pro 2D i 3D prostor." styleClass="panel-hint" wrapText="true"/>
</VBox>
