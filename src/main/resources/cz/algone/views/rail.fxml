<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.rail.RailController"
      id="rail"
      alignment="TOP_CENTER">

    <fx:define>
        <ToggleGroup fx:id="categoryToggle"/>
    </fx:define>

    <Label text="Nástroje" styleClass="rail-header"/>

    <!-- ============ Obecné ============ -->
    <VBox fx:id="generalCategories" styleClass="rail-group" visible="false">
        <ToggleButton userData="COLORS" toggleGroup="$categoryToggle"
                      text="Barvy" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M12 4 A8 8 0 1 0 12 20 C13.5 20 13 18.5 14 18 C15 17.5 17 18 18.5 17 C20 16 20 14 20 12 A8 8 0 0 0 12 4"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M8.5 10.5 L8.6 10.5 M11.5 8 L11.6 8 M15 9.5 L15.1 9.5 M8.5 14.5 L8.6 14.5"
                             styleClass="icon" strokeWidth="2.4"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="THICKNESS" toggleGroup="$categoryToggle"
                      text="Tloušťka" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M5 7 H19" styleClass="icon" strokeWidth="1.2" strokeLineCap="round"/>
                    <SVGPath content="M5 12 H19" styleClass="icon" strokeWidth="2.6" strokeLineCap="round"/>
                    <SVGPath content="M5 17 H19" styleClass="icon" strokeWidth="4.2" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="ANTIALIASING" toggleGroup="$categoryToggle"
                      text="Antialiasing" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M4 19 L9 19 L9 14 L14 14 L14 9 L19 9 L19 4"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M4 21 L21 4"
                             styleClass="icon" strokeWidth="1.2" opacity="0.55"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
    </VBox>

    <!-- ============ 2D ============ -->
    <VBox fx:id="categories2D" styleClass="rail-group" visible="false">
        <ToggleButton userData="RASTERIZATION" toggleGroup="$categoryToggle"
                      text="Rasterizace" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M4 18 L8 18 L8 14 L12 14 L12 10 L16 10 L16 6 L20 6"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="FILL" toggleGroup="$categoryToggle"
                      text="Vyplnit" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M8 6 L16 6 L14 16 L10 16 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 6 C9 4.5 10.2 3.5 12 3.5 C13.8 3.5 15 4.5 15 6"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M18 14 C16.8 15.6 16.2 16.6 16.2 17.6 C16.2 19.1 17.3 20.2 18.8 20.2 C20.3 20.2 21.4 19.1 21.4 17.6 C21.4 16.5 20.7 15.4 19.2 13.6 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="CLIP_2D" toggleGroup="$categoryToggle"
                      text="Ořezání" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M4 7 L11 4 L18 8 L15 17 L6 15 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 12 L16 9 L21 13 L17 21 L10 19 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="ERASER" toggleGroup="$categoryToggle"
                      text="Guma" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M7 16 L14 9 L19 14 L14 19 H9 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M4 19 H20"
                             styleClass="icon" strokeWidth="1.6" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="TEXT" toggleGroup="$categoryToggle"
                      text="Text" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M6 6 H18 M12 6 V19 M9.5 19 H14.5"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
    </VBox>

    <!-- ============ 3D ============ -->
    <VBox fx:id="categories3D" styleClass="rail-group" visible="false">
        <ToggleButton userData="SOLIDS" toggleGroup="$categoryToggle"
                      text="Tělesa" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M7 10 L15 10 L15 18 L7 18 Z"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M11 6 L19 6 L19 14 L11 14 Z"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M7 10 L11 6 M15 10 L19 6 M15 18 L19 14"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="CUBICS" toggleGroup="$categoryToggle"
                      text="Kubiky" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M3 16 C6 8, 10 8, 12 12 C14 16, 18 16, 21 8"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M3 16 L3.1 16 M12 12 L12.1 12 M21 8 L21.1 8"
                             styleClass="icon" strokeWidth="3.2"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="LIGHT" toggleGroup="$categoryToggle"
                      text="Světlo" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M12 7 A5 5 0 1 1 11.99 7"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M12 2 V4 M12 20 V22 M2 12 H4 M20 12 H22 M5 5 L6.5 6.5 M17.5 17.5 L19 19 M19 5 L17.5 6.5 M6.5 17.5 L5 19"
                             styleClass="icon" strokeWidth="1.4"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="PROJECTION" toggleGroup="$categoryToggle"
                      text="Projekce" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M8 9 V15 M8 9 L20 4 M8 15 L20 20 M20 4 V20"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M4 12 L8 9 M4 12 L8 15"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>

        <ToggleButton userData="CLIP_3D" toggleGroup="$categoryToggle"
                      text="Ořezání" contentDisplay="TOP" styleClass="rail-btn">
            <graphic>
                <Group>
                    <SVGPath content="M4 7 L11 4 L18 8 L15 17 L6 15 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 12 L16 9 L21 13 L17 21 L10 19 Z"
                             styleClass="icon" strokeWidth="1.6"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Region maxWidth="Infinity" styleClass="panel-separator"/>

    <!-- Spodní část railu — zatím placeholdery -->
    <VBox styleClass="rail-group, bottom">
        <Button disable="true" text="Animace" contentDisplay="TOP" styleClass="rail-btn">
            <tooltip><Tooltip text="Nabídka animací — zatím neimplementováno"/></tooltip>
            <graphic>
                <Group>
                    <SVGPath content="M4 6 H8 M4 12 H8 M4 18 H8"
                             styleClass="icon" strokeWidth="1.5" strokeLineCap="round"/>
                    <SVGPath content="M12 5 L20 12 L12 19 Z"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </Button>

        <Button disable="true" text="Nastavení" contentDisplay="TOP" styleClass="rail-btn">
            <tooltip><Tooltip text="Nastavení aplikace — zatím neimplementováno"/></tooltip>
            <graphic>
                <!-- Prsten s dírkou a krátkými zuby, aby se ikona nepletla se Světlem -->
                <Group>
                    <SVGPath content="M12 6 A6 6 0 1 1 11.99 6"
                             styleClass="icon" strokeWidth="1.5"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M12 9.8 A2.2 2.2 0 1 1 11.99 9.8"
                             styleClass="icon" strokeWidth="1.4"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M12 3.5 V6 M12 18 V20.5 M3.5 12 H6 M18 12 H20.5 M6.2 6.2 L7.7 7.7 M16.3 16.3 L17.8 17.8 M17.8 6.2 L16.3 7.7 M7.7 16.3 L6.2 17.8"
                             styleClass="icon" strokeWidth="1.4"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </Button>
    </VBox>
</VBox>
