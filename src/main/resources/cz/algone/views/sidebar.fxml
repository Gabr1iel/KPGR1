<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.Line?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Polygon?>
<?import javafx.scene.Group?>
<?import javafx.scene.shape.SVGPath?>
<VBox fx:id="sidebar"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.sidebar.SidebarController"
      spacing="12"
      styleClass="sidebar">

    <fx:define>
        <ToggleGroup fx:id="dropdownToggle"/>
    </fx:define>

    <Label text="Algone"
           styleClass="logo"/>

    <Separator styleClass="separator"/>

    <VBox>
        <ToggleButton fx:id="btnScenes"
                      maxWidth="Infinity"
                      toggleGroup="$dropdownToggle"
                      onAction="#toggleDropdown"
                      userData="sceneBox"
                      styleClass="sidebar-toggle"
                      selected="true">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Group>
                        <SVGPath content="M7 10 L15 10 L15 18 L7 18 Z"
                                 styleClass="sidebar-toggle, icon"
                                 fill="transparent"
                                 strokeWidth="1.8"
                                 strokeLineJoin="round"
                                 strokeLineCap="round"/>
                        <SVGPath content="M11 6 L19 6 L19 14 L11 14 Z"
                                 styleClass="sidebar-toggle, icon"
                                 fill="transparent"
                                 strokeWidth="1.8"
                                 strokeLineJoin="round"
                                 strokeLineCap="round"/>
                        <SVGPath content="M7 10 L11 6 M15 10 L19 6 M15 18 L19 14"
                                 styleClass="sidebar-toggle, icon"
                                 fill="transparent"
                                 strokeWidth="1.8"
                                 strokeLineJoin="round"
                                 strokeLineCap="round"/>
                    </Group>
                    <Label text="Scéna" styleClass="label"/>
                    <Polygon points="0, 0, 8, 0, 4, 6"
                             styleClass="sidebar-toggle, arrow-icon"/>
                </HBox>
            </graphic>
        </ToggleButton>

        <VBox fx:id="sceneBox" visible="false">
            <HBox>
                <Pane styleClass="separator, vertical">
                    <HBox.margin>
                        <Insets left="12" right="12"/>
                    </HBox.margin>
                </Pane>
                <fx:define>
                    <ToggleGroup fx:id="sceneToggle"/>
                </fx:define>
                <!-- BOX pro SCÉNY -->
                <VBox spacing="6"
                      fx:id="scenes"
                      userData="LINE"
                      styleClass="sidebar-section">

                    <ToggleButton fx:id="btn2D"
                                  userData="SCENE_2D"
                                  toggleGroup="$sceneToggle"
                                  text="2D"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>

                    <ToggleButton fx:id="btn3D"
                                  userData="SCENE_3D"
                                  toggleGroup="$sceneToggle"
                                  text="3D"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>

                </VBox>
            </HBox>
        </VBox>
    </VBox>

    <VBox spacing="4">
        <ToggleButton fx:id="btnAlgorithms"
                      maxWidth="Infinity"
                      toggleGroup="$dropdownToggle"
                      onAction="#toggleDropdown"
                      userData="algorithmBox"
                      styleClass="sidebar-toggle">
            <graphic>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Line startY="10"
                          endX="10"
                          styleClass="sidebar-toggle, line-icon"/>
                    <Label text="Algoritmy" styleClass="label"/>
                    <Polygon points="0, 0, 8, 0, 4, 6"
                             styleClass="sidebar-toggle, arrow-icon"/>
                </HBox>
            </graphic>
        </ToggleButton>

        <VBox fx:id="algorithmBox" visible="false">
            <HBox>
                <Pane styleClass="separator, vertical">
                    <HBox.margin>
                        <Insets left="12" right="12"/>
                    </HBox.margin>
                </Pane>
                <fx:define>
                    <ToggleGroup fx:id="algorithmToggle"/>
                </fx:define>
                <!-- BOX pro LINE algoritmy -->
                <VBox spacing="6"
                      fx:id="lineAlgorithms"
                      userData="LINE"
                      visible="false"
                      styleClass="sidebar-section">

                    <ToggleButton fx:id="btnBresenham"
                                  userData="BRESENHAM"
                                  toggleGroup="$algorithmToggle"
                                  text="Bresenham"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>

                    <ToggleButton fx:id="btnTrivial"
                                  userData="TRIVIAL"
                                  toggleGroup="$algorithmToggle"
                                  text="Trivial"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>

                    <ToggleButton fx:id="btnDDA"
                                  userData="DDA"
                                  toggleGroup="$algorithmToggle"
                                  text="DDA"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>
                </VBox>
                <!-- BOX pro FILL algoritmy -->
                <VBox spacing="6"
                      fx:id="seedFillAlgorithms"
                      userData="FILL"
                      visible="false"
                      styleClass="sidebar-section">
                    <ToggleButton fx:id="btnFillBackground"
                                  userData="SEED_FILL_BACKGROUND"
                                  toggleGroup="$algorithmToggle"
                                  text="Background"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>

                    <ToggleButton fx:id="btnFillBorder"
                                  userData="SEED_FILL_BORDER"
                                  toggleGroup="$algorithmToggle"
                                  text="Border"
                                  maxWidth="Infinity"
                                  styleClass="rasterizer-btn"/>
                </VBox>
            </HBox>
            <VBox fx:id="patterns" visible="false" style="-fx-end-margin: 20">
                <VBox.margin>
                    <Insets top="16"/>
                </VBox.margin>
                <Label text="Patterny" styleClass="sidebar-label">
                    <padding>
                        <Insets left="12" bottom="8"/>
                    </padding>
                </Label>
                <HBox>
                    <Pane styleClass="separator, vertical" prefHeight="Infinity">
                        <HBox.margin>
                            <Insets left="12" right="12"/>
                        </HBox.margin>
                    </Pane>
                    <!-- BOX pro toggle Patternů -->
                    <VBox spacing="6"
                          styleClass="sidebar-section">
                        <ToggleButton fx:id="btnTogglePattern"
                                      onAction="#togglePattern"
                                      text="OFF"
                                      maxWidth="Infinity"
                                      styleClass="rasterizer-btn"/>
                    </VBox>
                </HBox>
            </VBox>
            <VBox fx:id="clipModes" visible="false" style="-fx-end-margin: 20">
                <fx:define>
                    <ToggleGroup fx:id="orientationToggle"/>
                </fx:define>
                <VBox.margin>
                    <Insets top="16"/>
                </VBox.margin>
                <Label text="Orientace polygonu" styleClass="sidebar-label">
                    <padding>
                        <Insets left="12" bottom="8"/>
                    </padding>
                </Label>
                <HBox>
                    <Pane styleClass="separator, vertical" prefHeight="Infinity">
                        <HBox.margin>
                            <Insets left="12" right="12"/>
                        </HBox.margin>
                    </Pane>
                    <!-- BOX pro přepínání clip modů -->
                    <VBox spacing="6"
                          userData="FILL"
                          styleClass="sidebar-section">
                        <ToggleButton fx:id="btnClipAuto"
                                      selected="true"
                                      text="Auto"
                                      userData="AUTO"
                                      toggleGroup="$orientationToggle"
                                      maxWidth="Infinity"
                                      styleClass="rasterizer-btn"/>
                        <ToggleButton fx:id="btnClipCW"
                                      text="CW"
                                      userData="CW"
                                      toggleGroup="$orientationToggle"
                                      maxWidth="Infinity"
                                      styleClass="rasterizer-btn"/>
                        <ToggleButton fx:id="btnClipCCW"
                                      text="CCW"
                                      userData="CCW"
                                      toggleGroup="$orientationToggle"
                                      maxWidth="Infinity"
                                      styleClass="rasterizer-btn"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </VBox>
</VBox>