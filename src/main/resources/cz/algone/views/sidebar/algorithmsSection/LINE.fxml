<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>

<!-- BOX pro LINE algoritmy -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.sidebar.algorithmSection.LineAlgorithmSectionController"
      fx:id="algorithmBoxSection"
      spacing="6"
      userData="LINE"
      styleClass="sidebar-section">

    <fx:define>
        <ToggleGroup fx:id="algorithmToggle"/>
    </fx:define>

    <ToggleButton fx:id="btnBresenham"
                  userData="BRESENHAM"
                  toggleGroup="$algorithmToggle"
                  text="Bresenham"
                  maxWidth="Infinity"
                  styleClass="rasterizer-btn"/>

    <ToggleButton fx:id="btnTrivial"
                  userData="TRIVIAL"
                  toggleGroup="$algorithmToggle"
                  text="Trivial"
                  maxWidth="Infinity"
                  styleClass="rasterizer-btn"/>

    <ToggleButton fx:id="btnDDA"
                  userData="DDA"
                  toggleGroup="$algorithmToggle"
                  text="DDA"
                  maxWidth="Infinity"
                  styleClass="rasterizer-btn"/>
</VBox>
