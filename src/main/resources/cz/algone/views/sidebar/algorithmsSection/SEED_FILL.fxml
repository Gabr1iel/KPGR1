<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- BOX pro FILL algoritmy -->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.sidebar.algorithmSection.LineAlgorithmSectionController"
      fx:id="algorithmBoxSection"
      spacing="6"
      userData="SEED_FILL"
      styleClass="sidebar-section">

    <fx:define>
        <ToggleGroup fx:id="algorithmToggle"/>
    </fx:define>

    <ToggleButton fx:id="btnFillBackground"
                  userData="SEED_FILL_BACKGROUND"
                  toggleGroup="$algorithmToggle"
                  text="Background"
                  maxWidth="Infinity"
                  styleClass="rasterizer-btn"/>

    <ToggleButton fx:id="btnFillBorder"
                  userData="SEED_FILL_BORDER"
                  toggleGroup="$algorithmToggle"
                  text="Border"
                  maxWidth="Infinity"
                  styleClass="rasterizer-btn"/>
</VBox>
