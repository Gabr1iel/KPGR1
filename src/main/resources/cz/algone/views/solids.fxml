<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.Group?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.toolbar.solids.SolidsController"
      fx:id="solids"
      visible="false"
      alignment="CENTER">

    <FlowPane vgap="8" hgap="8" prefWrapLength="160">
        <ToggleButton fx:id="tetrahedronBtn"
                      userData="TETRAHEDRON"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- base triangle -->
                    <SVGPath content="M6 18 L18 18 L12 8 Z"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>

                    <!-- inner edge (apex to base midpoint) -->
                    <SVGPath content="M12 8 L12 18"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>

                    <!-- visible slanted edge hint (apex to left base corner already exists in base, so add one more) -->
                    <SVGPath content="M12 8 L18 18"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="cuboidBtn"
                      userData="CUBOID"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- front face -->
                    <SVGPath content="M7 10 L15 10 L15 18 L7 18 Z"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>

                    <!-- back face (offset up-right) -->
                    <SVGPath content="M11 6 L19 6 L19 14 L11 14 Z"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>

                    <!-- connectors -->
                    <SVGPath content="M7 10 L11 6 M15 10 L19 6 M15 18 L19 14"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="cylinderBtn"
                      userData="CYLINDER"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- top ellipse -->
                    <SVGPath content="M7 7 C7 5.2 9.7 4 12 4 C14.3 4 17 5.2 17 7 C17 8.8 14.3 10 12 10 C9.7 10 7 8.8 7 7"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>

                    <!-- sides -->
                    <SVGPath content="M7 7 V17 M17 7 V17"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>

                    <!-- bottom ellipse (visible front arc) -->
                    <SVGPath content="M7 17 C7 18.8 9.7 20 12 20 C14.3 20 17 18.8 17 17"
                             styleClass="icon"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="curveBtn"
                      userData="CURVE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M1.5 9 C3 5, 5 5, 6.5 9 C8 13, 10 13, 11.5 9 C13 5, 15 5, 16.5 9"
                             fill="transparent"
                             stroke="black"
                             styleClass="icon"
                             strokeWidth="1.3"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="planeBtn"
                      userData="SURFACE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M3 6 L11 4 L14 10 L6 12 Z"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 8 L9 2.5"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 2.5 L8.2 3.6 M9 2.5 L9.8 3.6"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="sphereBtn"
                      userData="SPHERE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M12 4 A8 8 0 1 1 11.99 4"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M4 12 C4 10 8 8.5 12 8.5 C16 8.5 20 10 20 12 C20 14 16 15.5 12 15.5 C8 15.5 4 14 4 12"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M12 4 C10.5 8 10.5 16 12 20"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="coneBtn"
                      userData="CONE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M12 4 L5 18 L19 18 Z"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M5 18 C5 19.5 8 20.5 12 20.5 C16 20.5 19 19.5 19 18"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="truncatedConeBtn"
                      userData="TRUNCATED_CONE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M8 6 L4 18 L20 18 L16 6 Z"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M4 18 C4 19.5 7.5 20.5 12 20.5 C16.5 20.5 20 19.5 20 18"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M8 6 C8 4.8 9.8 4 12 4 C14.2 4 16 4.8 16 6"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="icosahedronBtn"
                      userData="ICOSAHEDRON"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- outer triangle (D20 silhouette) -->
                    <SVGPath content="M12 3 L21 19 L3 19 Z"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- inner subdivisions -->
                    <SVGPath content="M12 3 L7.5 12 M12 3 L16.5 12"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M7.5 12 L16.5 12"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M7.5 12 L3 19 M16.5 12 L21 19"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="d100Btn"
                      userData="D100"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- outer circle -->
                    <SVGPath content="M12 4 A8 8 0 1 1 11.99 4"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- geodesic pentagon inside -->
                    <SVGPath content="M12 6 L16 9.5 L14.5 14 L9.5 14 L8 9.5 Z"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- center dot spokes -->
                    <SVGPath content="M12 6 L12 10 M16 9.5 L12 10 M14.5 14 L12 10 M9.5 14 L12 10 M8 9.5 L12 10"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.0"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="lightBtn"
                      userData="LIGHT"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- light bulb body -->
                    <SVGPath content="M12 4 A6 6 0 1 1 12 16 A6 6 0 1 1 12 4"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- rays -->
                    <SVGPath content="M12 1 V3 M12 17 V19 M4 10 H6 M18 10 H20 M6.3 4.3 L7.7 5.7 M16.3 14.3 L17.7 15.7 M17.7 4.3 L16.3 5.7 M7.7 14.3 L6.3 15.7"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.0"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
    </FlowPane>
    <Label text="Tělesa"/>
</VBox>
