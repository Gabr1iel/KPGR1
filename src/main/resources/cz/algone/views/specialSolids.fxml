<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.Group?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.toolbar.solids.SpecialSolidsController"
      fx:id="specialSolids"
      visible="false"
      alignment="CENTER">

    <FlowPane vgap="8" hgap="8" prefWrapLength="160">
        <ToggleButton fx:id="lightBtn"
                      userData="LIGHT"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M12 4 A6 6 0 1 1 12 16 A6 6 0 1 1 12 4"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M12 1 V3 M12 17 V19 M4 10 H6 M18 10 H20 M6.3 4.3 L7.7 5.7 M16.3 14.3 L17.7 15.7 M17.7 4.3 L16.3 5.7 M7.7 14.3 L6.3 15.7"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.0"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="curveBtn"
                      userData="CURVE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M1.5 9 C3 5, 5 5, 6.5 9 C8 13, 10 13, 11.5 9 C13 5, 15 5, 16.5 9"
                             fill="transparent"
                             stroke="black"
                             styleClass="icon"
                             strokeWidth="1.3"
                             strokeLineJoin="round"
                             strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="planeBtn"
                      userData="SURFACE"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <SVGPath content="M3 6 L11 4 L14 10 L6 12 Z"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 8 L9 2.5"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <SVGPath content="M9 2.5 L8.2 3.6 M9 2.5 L9.8 3.6"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="diskBtn"
                      userData="DISK"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- outer circle -->
                    <SVGPath content="M12 4 A8 8 0 1 1 11.99 4"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.3"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- fan spokes from center -->
                    <SVGPath content="M12 12 L20 12 M12 12 L15.7 5.1 M12 12 L8.3 5.1 M12 12 L4 12"
                             fill="transparent" stroke="black"
                             styleClass="icon" strokeWidth="1.0"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>
            </graphic>
        </ToggleButton>
    </FlowPane>
    <Label text="Speciální"/>
</VBox>
