<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>

<!-- Vlastní titulková lišta — prázdná plocha vlevo slouží k tažení okna -->
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.algone.ui.window.TitleBarController"
      styleClass="title-bar"
      alignment="CENTER_LEFT"
      onMousePressed="#onPressed"
      onMouseDragged="#onDragged"
      onMouseClicked="#onClicked">

    <Region HBox.hgrow="ALWAYS"/>

    <Button styleClass="window-btn" onAction="#minimize" focusTraversable="false">
        <tooltip><Tooltip text="Minimalizovat"/></tooltip>
        <graphic>
            <Group>
                <SVGPath content="M6 12 H18" styleClass="icon" strokeWidth="1.3" strokeLineCap="round"/>
            </Group>
        </graphic>
    </Button>

    <Button styleClass="window-btn" onAction="#toggleMaximize" focusTraversable="false">
        <tooltip><Tooltip text="Maximalizovat"/></tooltip>
        <graphic>
            <Group>
                <SVGPath fx:id="maximizeIcon"
                         content="M6 6 H18 V18 H6 Z"
                         styleClass="icon" strokeWidth="1.3"
                         strokeLineJoin="round" strokeLineCap="round"/>
            </Group>
        </graphic>
    </Button>

    <Button styleClass="window-btn, close" onAction="#close" focusTraversable="false">
        <tooltip><Tooltip text="Zavřít"/></tooltip>
        <graphic>
            <Group>
                <SVGPath content="M7 7 L17 17 M17 7 L7 17"
                         styleClass="icon" strokeWidth="1.3" strokeLineCap="round"/>
            </Group>
        </graphic>
    </Button>
</HBox>
