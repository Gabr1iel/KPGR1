<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>

<?import javafx.scene.Group?>
<?import javafx.scene.shape.SVGPath?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:id="tools"
      alignment="CENTER"
      fx:controller="cz.algone.ui.toolbar.tools.ToolsController">
    <fx:define>
        <ToggleGroup fx:id="toggleBtns"/>
    </fx:define>
    <FlowPane vgap="8" hgap="8" prefWrapLength="95">
        <ToggleButton fx:id="seedfillBtn"
                      toggleGroup="$toggleBtns"
                      userData="SEED_FILL"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- bucket -->
                    <SVGPath content="M8 6 L16 6 L14 16 L10 16 Z"
                             fill="transparent" stroke="black" strokeWidth="1.8"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- handle -->
                    <SVGPath content="M9 6 C9 4.5 10.2 3.5 12 3.5 C13.8 3.5 15 4.5 15 6"
                             fill="transparent" stroke="black" strokeWidth="1.8"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- droplet -->
                    <SVGPath content="M18 14 C16.8 15.6 16.2 16.6 16.2 17.6 C16.2 19.1 17.3 20.2 18.8 20.2 C20.3 20.2 21.4 19.1 21.4 17.6 C21.4 16.5 20.7 15.4 19.2 13.6 Z"
                             fill="transparent" stroke="black" strokeWidth="1.8"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>

            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="scanlineBtn"
                      toggleGroup="$toggleBtns"
                      userData="SCANLINE_FILL"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <!-- scan line -->
                    <SVGPath content="M4 12 H20"
                             fill="transparent" stroke="black" strokeWidth="1.8"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- polygon edge -->
                    <SVGPath content="M7 18 L17 6"
                             fill="transparent" stroke="black" strokeWidth="1.8"
                             strokeLineJoin="round" strokeLineCap="round"/>
                    <!-- intersection marker -->
                    <SVGPath content="M11.7 12 L12.3 12"
                             fill="transparent" stroke="black" strokeWidth="3.2"
                             strokeLineJoin="round" strokeLineCap="round"/>
                </Group>

            </graphic>
        </ToggleButton>
        <ToggleButton fx:id="clipBtn"
                      toggleGroup="$toggleBtns"
                      userData="CLIP"
                      styleClass="square-btn">
            <graphic>
                <Group>
                    <Group>
                        <!-- polygon A (levější / hornější) -->
                        <SVGPath content="M4 7 L11 4 L18 8 L15 17 L6 15 Z"
                                 fill="transparent"
                                 stroke="black"
                                 strokeWidth="1.8"
                                 strokeLineJoin="round"
                                 strokeLineCap="round"/>

                        <!-- polygon B (pravější / spodnější, posunutý) -->
                        <SVGPath content="M9 12 L16 9 L21 13 L17 21 L10 19 Z"
                                 fill="transparent"
                                 stroke="black"
                                 strokeWidth="1.8"
                                 strokeLineJoin="round"
                                 strokeLineCap="round"/>
                    </Group>

                </Group>

            </graphic>
        </ToggleButton>
    </FlowPane>
    <Label text="Nástroje"/>
</VBox>
